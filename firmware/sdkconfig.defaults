# 目标芯片：开发板主控 ESP32-S3
CONFIG_IDF_TARGET="esp32s3"

# CPU 240MHz（M1 定案；sdkconfig 重建后默认 160MHz，SD 1-bit 读与 Opus 定点
# 编码实测明显劣化，M4.4 大文件 CRC 冷算 0.8MB/s → 恢复 240MHz）
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# Flash 大小：M1 实测 32MB（GigaDevice，esptool flash_id 确认）。
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y

# 控制台：本板无 USB-UART 桥，USB-C 直连 S3 原生 USB，
# 日志与烧录都走 USB Serial/JTAG（出厂固件会关闭 USB，故烧录需先进入下载模式）。
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# 分区表：32MB 自定义布局，见 partitions.csv。
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM（M3）：ESP32-S3R8 合封 8MB octal PSRAM。
# Opus 编码器 state/pseudostack 经 CAPS 分配落 PSRAM；同时为 M4 BLE、
# M5 LVGL framebuffer 预留内部 RAM。
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y

# Opus 定点模式（M3）：micro-opus 在 ESP32-S3 上默认启用浮点（有硬件 FPU），
# 但其官方 benchmark 显示浮点 SILK 编码比定点慢 4~6 倍、最低复杂度也无法实时；
# 定点才可实时，故显式关闭浮点走定点实现。编码器 state/pseudostack 分配
# 走组件 Kconfig 默认（线程安全 pseudostack + PSRAM 优先），无需额外配置。
CONFIG_OPUS_FLOATING_POINT=n

# BLE（M4.1）：NimBLE host 单连接（规划 D9），ATT MTU 247（BUZZLINK.md §2.1）；
# 只用 peripheral 能力，不启用 Bluedroid/mesh/blufi，其余 NimBLE 配置走组件默认。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# BLE 下载吞吐（M4.4 实测定案）：控制器 ACL TX 缓冲全量静态化（默认 0 =
# 全动态分配，notify 发送速率被压到 ~1.4 包/连接事件 ≈ 20 KB/s）；
# CE 长度用乐鑫自定义算法（默认 ORIG 提前结束连接事件，空口填不满）；
# msys mbuf 池加深（官方吞吐示例同款 50+8，抗突发排空）。
# 依据：M4.4 报告吞吐实测与 ESP-IDF 吞吐调优指引。
CONFIG_BT_CTRL_BLE_STATIC_ACL_TX_BUF_NB=12
CONFIG_BT_CTRL_CE_LENGTH_TYPE_SD=y
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=50
